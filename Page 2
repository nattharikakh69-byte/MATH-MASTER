"""หน้าโจทย์คณิตศาสตร์ 30 ข้อของเกม MATH MASTER"""
import random

import storage


TITLE = "ทดสอบ"
LEVELS = ["ง่าย", "ปานกลาง", "ยาก"]


def normalize_player_name(name):
	"""ทำให้ชื่อที่มีช่องว่างหรือรูปแบบตัวพิมพ์ต่างกันเป็นชื่อเดียวกัน"""
	return name.strip().upper()


def get_player():
	"""อ่านชื่อและระดับความยากล่าสุดของผู้เล่น"""
	player = {"name": "ผู้เล่น", "difficulty": "ง่าย"}
	for item in storage.load():
		if item.get("type") == "player":
			player["name"] = item.get("name", player["name"])
			player["difficulty"] = item.get("difficulty", player["difficulty"])
	if player["difficulty"] not in LEVELS:
		player["difficulty"] = "ง่าย"
	return player


def save_player(player_name, difficulty):
	"""บันทึกชื่อและระดับความยากที่ส่งมาจากหน้าเมนู"""
	player_name = normalize_player_name(player_name)
	data = storage.load()
	player_saved = False
	for item in data:
		if item.get("type") == "player":
			item["name"] = player_name
			item["difficulty"] = difficulty
			player_saved = True
	if not player_saved:
		data.append({"type": "player", "name": player_name, "difficulty": difficulty})
	storage.save(data)


def _unique_question(used, text, answer, category):
	"""สร้างโจทย์พร้อมหมวด เพื่อกันข้อความซ้ำในเกมเดียว"""
	if text in used:
		return None
	used.add(text)
	return {"text": text, "answer": answer, "category": category}


def generate_easy_question(rng, used):
	"""สุ่มโจทย์คิดเลขเร็วระดับพื้นฐาน"""
	category = rng.choice(["บวก", "ลบ", "คูณ", "หาร", "หลายขั้นตอน"])
	if category == "บวก":
		first, second = rng.randint(12, 89), rng.randint(11, 99)
		return _unique_question(used, f"{first} + {second} = ?", first + second, category)
	if category == "ลบ":
		first, second = rng.randint(40, 150), rng.randint(10, 39)
		return _unique_question(used, f"{first} - {second} = ?", first - second, category)
	if category == "คูณ":
		first, second = rng.randint(3, 15), rng.randint(2, 12)
		return _unique_question(used, f"{first} × {second} = ?", first * second, category)
	if category == "หาร":
		answer, divisor = rng.randint(2, 15), rng.randint(2, 12)
		dividend = answer * divisor
		return _unique_question(used, f"{dividend} ÷ {divisor} = ?", answer, category)
	first, second, multiplier = rng.randint(2, 15), rng.randint(2, 9), rng.randint(2, 4)
	return _unique_question(
		used, f"{first} + {second} × {multiplier} = ?",
		first + second * multiplier, category)


def generate_medium_question(rng, used):
	"""สุ่มโจทย์ระดับมัธยมต้น-ปลาย โดยผสมการคำนวณและการวิเคราะห์"""
	category = rng.choice([
		"เศษส่วน", "ร้อยละ", "สมการ", "กำลังสอง", "รากที่สอง",
		"พีทาโกรัส", "ลำดับ", "ความน่าจะเป็น", "พื้นที่", "ฟังก์ชัน"])
	if category == "เศษส่วน":
		denominator = rng.choice([2, 3, 4, 5, 6])
		numerator = rng.randint(1, denominator - 1)
		multiplier = rng.randint(2, 8)
		return _unique_question(
			used, f"{numerator}/{denominator} × {multiplier} = ? (ตอบเป็นทศนิยม)",
			numerator * multiplier / denominator, category)
	if category == "ร้อยละ":
		percent, amount = rng.choice([10, 15, 20, 25, 30]), rng.choice([80, 120, 160, 200])
		return _unique_question(used, f"{percent}% ของ {amount} = ?", percent * amount // 100, category)
	if category == "สมการ":
		x = rng.randint(2, 15)
		coefficient = rng.randint(2, 6)
		constant = rng.randint(2, 12)
		total = coefficient * x + constant
		return _unique_question(used, f"{coefficient}x + {constant} = {total} จงหา x", x, category)
	if category == "กำลังสอง":
		root = rng.randint(2, 10)
		other = rng.randint(1, 5)
		return _unique_question(used, f"x² - {root + other}x + {root * other} = 0 รากที่น้อยกว่าคือเท่าไร", min(root, other), category)
	if category == "รากที่สอง":
		value = rng.choice([36, 49, 64, 81, 100, 121, 144, 169])
		extra = rng.randint(2, 8)
		return _unique_question(used, f"√{value} + {extra}² = ?", int(value ** 0.5) + extra ** 2, category)
	if category == "พีทาโกรัส":
		leg_a, leg_b = rng.choice([(3, 4), (5, 12), (6, 8), (8, 15)])
		hypotenuse = int((leg_a ** 2 + leg_b ** 2) ** 0.5)
		return _unique_question(used, f"สามเหลี่ยมมุมฉากมีด้าน {leg_a} และ {leg_b} ด้านตรงข้ามมุมฉากยาวเท่าไร", hypotenuse, category)
	if category == "ลำดับ":
		first, ratio = rng.randint(2, 8), rng.choice([2, 3])
		return _unique_question(used, f"ลำดับ {first}, {first * ratio}, {first * ratio ** 2}, ... พจน์ถัดไปคืออะไร", first * ratio ** 3, category)
	if category == "ความน่าจะเป็น":
		red, blue = rng.randint(2, 5), rng.randint(2, 6)
		return _unique_question(used, f"ถุงมีลูกบอลแดง {red} ลูก น้ำเงิน {blue} ลูก ความน่าจะเป็นที่จะหยิบได้สีแดง (ตัวเศษ) คือเท่าไร", red, category)
	if category == "พื้นที่":
		width, height = rng.randint(4, 12), rng.randint(5, 15)
		return _unique_question(used, f"สี่เหลี่ยมผืนผ้ากว้าง {width} ยาว {height} มีพื้นที่เท่าไร", width * height, category)
	x, slope, intercept = rng.randint(2, 8), rng.randint(2, 5), rng.randint(1, 9)
	return _unique_question(used, f"ถ้า f(x) = {slope}x + {intercept} แล้ว f({x}) เท่ากับเท่าไร", slope * x + intercept, category)


def generate_hard_question(rng, used):
	"""สุ่มโจทย์ Calculus 1 ระดับมหาวิทยาลัยปี 1"""
	category = rng.choice(["ลิมิต", "อนุพันธ์", "อินทิกรัล", "ความชัน", "ค่าต่ำสุด", "ฟังก์ชัน"])
	if category == "ลิมิต":
		value = rng.randint(2, 8)
		return _unique_question(used, f"lim เมื่อ x→{value} ของ (x² − {value ** 2})/(x − {value}) = ?", 2 * value, category)
	if category == "อนุพันธ์":
		coefficient, power = rng.randint(2, 8), rng.randint(2, 5)
		x_value = rng.randint(1, 4)
		return _unique_question(used, f"ถ้า f(x) = {coefficient}x^{power} จงหา f'({x_value})", coefficient * power * x_value ** (power - 1), category)
	if category == "อินทิกรัล":
		coefficient, power = rng.randint(2, 8), rng.randint(1, 4)
		return _unique_question(used, f"∫ {coefficient}x^{power} dx มีสัมประสิทธิ์ของ x^{power + 1} เท่าไร", coefficient / (power + 1), category)
	if category == "ความชัน":
		slope, x_value = rng.randint(2, 8), rng.randint(1, 5)
		return _unique_question(used, f"เส้นโค้ง y = {slope}x² มีความชันเมื่อ x = {x_value} เท่าไร", 2 * slope * x_value, category)
	if category == "ค่าต่ำสุด":
		vertex = rng.randint(2, 8)
		return _unique_question(used, f"f(x) = x² − {2 * vertex}x + 5 มีค่าต่ำสุดเมื่อ x เท่าไร", vertex, category)
	x_value = rng.randint(1, 5)
	return _unique_question(used, f"กำหนด f(x) = x² + {x_value} และ g(x) = x + 2 ค่า f(g({x_value})) เท่ากับเท่าไร", (x_value + 2) ** 2 + x_value, category)


def make_questions(difficulty, seed=None):
	"""สร้างโจทย์ 30 ข้อแบบสุ่ม ไม่ซ้ำ และไม่ใช้หมวดเดิมติดกัน"""
	rng = random.Random(seed)
	generator = {
		"ง่าย": generate_easy_question,
		"ปานกลาง": generate_medium_question,
		"ยาก": generate_hard_question,
	}[difficulty]
	questions, used = [], set()
	previous_category = None
	attempts = 0
	while len(questions) < 30 and attempts < 3000:
		attempts += 1
		question = generator(rng, used)
		if question is None or question["category"] == previous_category:
			continue
		question["no"] = len(questions) + 1
		questions.append(question)
		previous_category = question["category"]
	if len(questions) != 30:
		raise RuntimeError("ไม่สามารถสร้างโจทย์ที่ไม่ซ้ำครบ 30 ข้อได้")
	return questions


def build(query):
	"""แสดงชื่อ ระดับที่เลือก และโจทย์ 30 ข้อ"""
	player_name = query.get("player_name", "").strip()
	difficulty = query.get("difficulty", "").strip()
	if player_name and difficulty in LEVELS:
		save_player(player_name, difficulty)
	player = get_player()
	seed_text = query.get("seed", "")
	try:
		seed = int(seed_text)
	except ValueError:
		seed = random.SystemRandom().randrange(1, 2 ** 31)
	questions = make_questions(player["difficulty"], seed)
	return {
		"player_name": player["name"],
		"difficulty": player["difficulty"],
		"questions": questions,
		"question_count": len(questions),
		"question_seed": seed,
	}


def handle(form):
	"""ตรวจคำตอบทั้ง 30 ข้อและคำนวณ Speed bonus"""
	player = get_player()
	difficulty = form.get("difficulty", player["difficulty"])
	if difficulty not in LEVELS:
		difficulty = player["difficulty"]
	try:
		seed = int(form.get("question_seed", ""))
	except ValueError:
		seed = 0
	questions = make_questions(difficulty, seed)
	correct_count = 0

	# ใช้ loop วนตรวจคำตอบของโจทย์ทั้ง 30 ข้อ
	for question in questions:
		answer = form.get("answer_" + str(question["no"]), "").strip()
		# ใช้ if ตรวจว่าคำตอบเป็นตัวเลขและถูกต้องหรือไม่
		if answer != "":
			try:
				numeric_answer = float(answer)
				expected_answer = float(question["answer"])
			except ValueError:
				continue
			if abs(numeric_answer - expected_answer) < 1e-9:
				correct_count = correct_count + 1

	try:
		elapsed_seconds = float(form.get("elapsed_seconds", "0"))
	except ValueError:
		elapsed_seconds = 0
	if elapsed_seconds <= 0:
		elapsed_seconds = 1

	if correct_count == 30 and elapsed_seconds <= 60:
		speed_bonus = 10
	elif correct_count >= 25 and elapsed_seconds <= 120:
		speed_bonus = 5
	else:
		speed_bonus = 0
	total_score = correct_count + speed_bonus

	data = storage.load()
	player_name = normalize_player_name(player["name"])
	scores = {}
	score_difficulties = {}
	for item in data:
		if item.get("type") == "score":
			name = normalize_player_name(item.get("name", ""))
			if name:
				scores[name] = scores.get(name, 0) + item.get("score", 0)
				score_difficulties[name] = item.get("difficulty", score_difficulties.get(name, difficulty))
	scores[player_name] = scores.get(player_name, 0) + total_score
	score_difficulties[player_name] = difficulty

	# เก็บคะแนนรวมต่อชื่อไว้ใน JSON เพื่อไม่สร้างผู้เล่นซ้ำใน Leaderboard
	data = [item for item in data if item.get("type") != "score"]
	for name, score in scores.items():
		data.append({
			"type": "score",
			"name": name,
			"difficulty": score_difficulties.get(name, "ง่าย"),
			"score": score,
		})
	storage.save(data)
	return "ระดับ " + difficulty + " | ตอบถูก " + str(correct_count) + "/30 ข้อ | Speed bonus: +" + str(speed_bonus) + " | คะแนนรวม: " + str(total_score)
