{% extends "base.html" %}
{% block content %}
<h1>{{ title }}</h1>
<p class="lead">ผู้เล่น: {{ player_name }} | ระดับ: {{ difficulty }} | ตอบโจทย์ {{ question_count }} ข้อ</p>

<form method="post" class="panel" id="quiz-form">
	<input type="hidden" name="elapsed_seconds" id="elapsed_seconds" value="0">
	<input type="hidden" name="difficulty" value="{{ difficulty }}">
	<p>ใช้เวลาน้อยและตอบถูกให้มากที่สุด เพื่อรับ Speed bonus</p>
	{% for question in questions %}
	<div class="field">
		<label for="answer_{{ question.no }}">ข้อ {{ question.no }}: {{ question.text }}</label>
		<input id="answer_{{ question.no }}" name="answer_{{ question.no }}" inputmode="numeric" placeholder="คำตอบ">
	</div>
	{% endfor %}
	<button class="btn" type="submit">ส่งคำตอบและคำนวณคะแนน</button>
</form>

<p><a class="btn" href="/page1">ย้อนกลับ</a></p>
{% endblock %}
{% block scripts %}
<script>
	const startTime = Date.now();
	document.getElementById("quiz-form").addEventListener("submit", function () {
		document.getElementById("elapsed_seconds").value = Math.round((Date.now() - startTime) / 1000);
	});
</script>
{% endblock %}
