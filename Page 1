"""หน้าเริ่มต้นเกม MATH MASTER"""
import storage


TITLE = "MATH MASTER"


def build(query):
	"""เตรียมข้อมูลเมนูหลักและความยากที่ผู้เล่นเลือกไว้"""
	data = storage.load()
	view = query.get("view", "")
	player_name = ""
	selected_difficulty = "ง่าย"

	for item in data:
		if item.get("type") == "player":
			player_name = item.get("name", "")
			selected_difficulty = item.get("difficulty", "ง่าย")

	menu_items = ["START GAME", "LEADERBOARD", "HOW TO PLAY"]
	difficulty_items = ["ง่าย", "ปานกลาง", "ยาก"]

	return {
		"player_name": player_name,
		"menu_items": menu_items,
		"difficulty_items": difficulty_items,
		"selected_difficulty": selected_difficulty,
		"view": view,
	}


def handle(form):
	"""บันทึกชื่อผู้เล่นและระดับความยากก่อนเริ่มเกม"""
	player_name = form.get("player_name", "").strip()
	action = form.get("action", "")
	difficulty = form.get("difficulty", "").strip()
	if difficulty not in ["ง่าย", "ปานกลาง", "ยาก"]:
		difficulty = "ง่าย"

	if action == "SAVE PROFILE":
		if player_name == "":
			return "กรุณากรอกชื่อไอดีผู้เล่น"
		data = storage.load()
		player_saved = False
		for item in data:
			if item.get("type") == "player":
				item["name"] = player_name
				item["difficulty"] = difficulty
				player_saved = True
		if not player_saved:
			data.append({"type": "player", "name": player_name, "difficulty": difficulty})
		storage.save(data)
		return "บันทึกไอดีผู้เล่นแล้ว: " + player_name

	if player_name == "":
		return "กรุณากรอกชื่อไอดีผู้เล่นก่อนเริ่มเกม"
	if action == "START GAME":
		data = storage.load()
		player_saved = False
		for item in data:
			if item.get("type") == "player":
				item["name"] = player_name
				item["difficulty"] = difficulty
				player_saved = True
		if not player_saved:
			data.append({"type": "player", "name": player_name, "difficulty": difficulty})
		storage.save(data)
		return "กำลังเริ่มเกมระดับ " + difficulty
	elif action == "LEADERBOARD":
		return "Opening the leaderboard"
	elif action == "HOW TO PLAY":
		return "Opening the game guide"
	return "กรุณาเลือกเมนู"
